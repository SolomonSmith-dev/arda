# API Auth
ARDA_API_KEY=arda-dev-key-2026

# LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Dev Mode -- set true to skip all real LLM calls
USE_MOCK_LLM=true

# Mock embedder for Finrod (RAG). Defaults to mirroring USE_MOCK_LLM.
# Set to true on weak hosts to keep real LLM calls but skip the
# ~1GB sentence-transformers / torch download.
# USE_MOCK_EMBEDDER=true

# Model Overrides (optional)
ORCHESTRATOR_MODEL=gemini-2.5-flash
EXECUTOR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
RETRIEVER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
SPECIALIST_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Discord (Tom Bombadil)
DISCORD_TOKEN=
TMDB_API_KEY=

# Telegram (Gwaihir bot)
# Token from @BotFather. Comma-separated allowlist of numeric chat IDs;
# get yours by DMing @userinfobot. Empty allowlist = open mode (dev only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Earendil / MCP (Mac Mini connection)
EARENDIL_HOST=http://100.112.3.116:5000
EARENDIL_API_KEY=earendil-dev-key-2026

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
