# API Auth
ARDA_API_KEY=arda-dev-key-2026

# LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=
# Anthropic Claude. Reserved -- unused in PR 1; consumed by future
# fact-extractor swap and intent-classifier work.
CLAUDE_API_KEY=

# Dev Mode -- set true to skip all real LLM calls
USE_MOCK_LLM=true

# Mock embedder for Finrod (RAG). Defaults to mirroring USE_MOCK_LLM.
# Set to true on weak hosts to keep real LLM calls but skip the
# ~1GB sentence-transformers / torch download.
# USE_MOCK_EMBEDDER=true

# Model Overrides (optional)
ORCHESTRATOR_MODEL=claude-opus-4-7
EXECUTOR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
RETRIEVER_MODEL=claude-haiku-4-5-20251001
SPECIALIST_MODEL=claude-haiku-4-5-20251001

# Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Discord (Tom Bombadil)
DISCORD_TOKEN=
TMDB_API_KEY=

# Letterboxd export merge (PR 1). LETTERBOXD_EXPORT_DIR points at the
# unzipped Letterboxd CSV export; LETTERBOXD_VIEWER_NAME forces the
# merge to land under the canonical name from FILM_DATABASE so the
# Discord bot recognises the loaded ratings as the owner's.
LETTERBOXD_EXPORT_DIR=/app/data/letterboxd
LETTERBOXD_VIEWER_NAME=Solomon Smith

# Letterboxd auto-sync (PR 5). Polls
# https://letterboxd.com/{LETTERBOXD_USERNAME}/rss/ on the schedule
# installed by ``ensure_letterboxd_sync_cron`` (default daily 6am PT).
# When TOM_LETTERBOXD_ANNOUNCE_CHANNEL_ID is set, each newly-logged
# film is posted to that channel via Galadriel's discord delivery.
LETTERBOXD_USERNAME=
TOM_LETTERBOXD_ANNOUNCE_CHANNEL_ID=

# Tom Bombadil identity map. Override the in-container path during
# tests; production reads /app/data/tombombadil/identity.yaml from the
# mount declared in docker-compose.yml.
# TOMBOMBADIL_IDENTITY_FILE=/app/data/tombombadil/identity.yaml

# Telegram (Gwaihir bot)
# Token from @BotFather. Comma-separated allowlist of numeric chat IDs;
# get yours by DMing @userinfobot. Empty allowlist = open mode (dev only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Unified ARDA API base URL -- the MCP server (mcp_server/server.py) talks
# to it over HTTP. Auth uses ARDA_API_KEY at the top of this file.
ARDA_API_URL=http://localhost:5000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
