# Template for .env.demo (gitignored). Copy it, then fill the two secrets on the
# server. Never commit the filled-in file. See docs/deploy-demo.md.
DEMO_MODE=true

# Replaced by the runbook with a random value. Only guards routes that demo mode
# blocks anyway; it still must be set because the app refuses to start without it.
ARDA_API_KEY=replace-me

# Paste on the server with `read -rs`, not into this file in git.
ANTHROPIC_API_KEY=

USE_MOCK_LLM=false
# Lexical embedder: no torch download, runs on the old CPU.
USE_MOCK_EMBEDDER=true

# Haiku keeps the public demo cheap. Opus costs far more per visitor.
ORCHESTRATOR_MODEL=claude-haiku-4-5-20251001
RETRIEVER_MODEL=claude-haiku-4-5-20251001

# Budgets. Tune after watching a week of /demo/status.
DEMO_RATE_LIMIT_PER_IP=10
DEMO_DAILY_TOKEN_CAP=150000
DEMO_MAX_MESSAGE_CHARS=500

# Safe only because the API binds to 127.0.0.1 and cloudflared is the sole client.
DEMO_TRUST_CF_HEADER=true
